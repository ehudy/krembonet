# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Set this to your own zone. Left unset the poller's cron runs in UTC, which
# matters as soon as alerts are tied to a time of day.
TZ=UTC

DATABASE_PATH=./data/krembonet.db

# Optional device seeded on boot. There is deliberately no default address:
# leave these empty and the hub starts with an empty device list rather than
# polling an address that is not yours. Set both together, or neither.
PLOTTER_HOST=
PLOTTER_IPP_URI=
# Display name for the seeded device. Defaults to "Plotter".
PLOTTER_NAME=

# Optional JSON file mapping vendor media codes (com.canon-012f) to human names.
# Printers report codes only, so without a pack the UI shows the raw code until
# someone names it in the admin portal. Generate one from your printer's PPD:
#   npm run seed:media --workspace=@krembonet/server -- /path/to.ppd media-pack.json
MEDIA_PACK_PATH=

# Hard ceiling on a single device request, whatever the protocol. The older
# IPPTOOL_TIMEOUT_MS is still honoured.
DEVICE_TIMEOUT_MS=5000

# Background poll cadence, in minutes. This drives ink/paper reads and the
# low-ink alert checks. Applied on first boot only; after that the admin portal
# owns the value and stores it in SQLite, so changing it needs no redeploy.
# The print queue is not on this cadence — it refreshes on demand.
BACKGROUND_POLL_MINUTES=60

# Optional, but recommended for anything that matters.
#
# Encrypts secrets at rest — the SMTP password, SNMP community strings, SNMPv3
# keys, and webhook auth headers — so a copy of the database file is not a copy
# of your credentials.
#
# Left blank, a key is generated on first boot and stored at
# data/encryption.key (mode 600). That is what makes `docker compose up` work
# with no setup. The trade-off: the key then sits in the same directory as the
# database, so anyone who copies all of data/ gets both. Setting it here and
# keeping it somewhere else is stronger.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Either way, back up whichever one you use. Losing it means re-entering every
# stored secret; changing it has the same effect. The hub tells you exactly
# which secrets are affected on the next boot rather than failing silently.
ENCRYPTION_KEY=

# Set this to true when the hub is served over HTTPS, so the session cookie is
# marked Secure. Left false for a plain-HTTP LAN deployment, where a Secure
# cookie would never be sent and nobody could log in.
COOKIE_SECURE=false

# Admin portal. Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Leave blank and the first visit shows a setup wizard instead —
# that is the normal path. Set it for deployments provisioned by a script: it
# is hashed into the database at boot, never compared in plaintext, and
# changing it re-seeds the hash on the next restart. A password set through the
# wizard takes precedence and is never overwritten.
ADMIN_PASSWORD=

# How long a dashboard unlocked with the viewer passcode stays unlocked, in
# hours. Far longer than an admin session by design: a viewer session shows
# read-only supply levels, and a wall display that demands a PIN every morning
# ends up with the PIN taped next to it. Access mode and the passcode itself
# are set in the admin portal, not here.
VIEWER_SESSION_HOURS=720

# Optional. How this hub is reached from a browser, e.g. http://hub.lan:3000.
# Used only to put a working link in a webhook notification — the server cannot
# infer it, since it binds to 0.0.0.0 behind whatever hostname you chose. Left
# blank, notifications carry no link, which beats one that 404s in a Discord
# channel.
PUBLIC_BASE_URL=

# Subnet auto-discovery (Admin -> Devices -> Auto-discover).
#
# Discovery is a port scanner, so it refuses address ranges outside the private
# blocks by default. Set this only if your own network genuinely uses public
# addressing internally, which some universities and older enterprises do.
DISCOVERY_ALLOW_PUBLIC_RANGES=false

# Hard ceiling on one sweep, in milliseconds. Partial results are returned and
# flagged as partial when it is hit.
DISCOVERY_DEADLINE_MS=120000
