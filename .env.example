# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Set this to your own zone. Left unset the poller's cron runs in UTC, which
# matters as soon as alerts are tied to a time of day.
TZ=UTC

DATABASE_PATH=./data/krembonet.db

# Optional device seeded on boot. There is deliberately no default address:
# leave these empty and the hub starts with an empty device list rather than
# polling an address that is not yours. Set both together, or neither.
PLOTTER_HOST=
PLOTTER_IPP_URI=
# Display name for the seeded device. Defaults to "Plotter".
PLOTTER_NAME=

# Optional JSON file mapping vendor media codes (com.canon-012f) to human names.
# Printers report codes only, so without a pack the UI shows the raw code until
# someone names it in the admin portal. Generate one from your printer's PPD:
#   npm run seed:media --workspace=@krembonet/server -- /path/to.ppd media-pack.json
MEDIA_PACK_PATH=

# Hard ceiling on a single device request, whatever the protocol. The older
# IPPTOOL_TIMEOUT_MS is still honoured.
DEVICE_TIMEOUT_MS=5000

# Background poll cadence, in minutes. This drives ink/paper reads and the
# low-ink alert checks. Applied on first boot only; after that the admin portal
# owns the value and stores it in SQLite, so changing it needs no redeploy.
# The print queue is not on this cadence — it refreshes on demand.
BACKGROUND_POLL_MINUTES=60

# Admin portal. An empty ADMIN_PASSWORD disables the portal entirely rather
# than leaving it open. Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ADMIN_PASSWORD=
