node_modules/
dist/
*.tsbuildinfo

# Vite builds the SPA straight into the server's static root
server/public/

# SQLite lives on the Docker volume mount — never commit its contents.
#
# `data/*` rather than `data/`, with the .gitkeep negated, so the directory
# exists after a clone. It matters: with a bind mount, Docker creates a missing
# source directory owned by root, and the container's unprivileged `node` user
# then cannot write the database or the generated encryption key. A directory
# that already exists belongs to whoever cloned the repo, and works.
data/*
!data/.gitkeep
*.db
*.db-journal
*.db-shm
*.db-wal

# The auto-generated encryption key. `data/` already covers the default
# location; these catch it wherever DATABASE_PATH puts it.
encryption.key
*.key

# Every .env variant, and then the template back. `.env.production` and
# `.env.development.local` are as easy to create and as damaging to commit as
# `.env` itself, and the two-line pair covers whatever gets invented next.
.env
.env.*
!.env.example
*.log

# Internal working notes. An audit report is a map of what is and is not
# defended, written for the person who commissioned it — useful to keep beside
# the repository, not to publish with it. `audit-*` catches the follow-ups.
SECURITY_AUDIT_REPORT.md
audit-*.md

# TLS material and anything that looks like it. `*.key` above already catches
# the encryption key; these are the certificate and bundle forms that would
# otherwise ride along with a reverse-proxy setup committed by accident.
*.pem
*.crt
*.cer
*.pfx
*.p12

# SQLite under whatever name DATABASE_PATH gave it. `*.db` above covers the
# default; these cover the other conventional extensions.
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# Not produced by this repo's build — Vite writes to server/public — but a
# habit-formed `npm run build` in a subdirectory should not surprise anyone.
build/

# Test-coverage output. Nothing generates it today; every runner that might
# writes here by default.
coverage/

# Generated from a vendor PPD — the names are vendor product names, so packs
# stay local rather than being redistributed here.
media-pack.json

.DS_Store
.vscode/
.idea/
